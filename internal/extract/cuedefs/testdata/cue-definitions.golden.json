    {
      "name": "#Module",
      "anchor": "module",
      "page": "modules",
      "file": "src/module.cue",
      "summary": "The unit an author publishes.",
      "notes": [
        "It holds components and the values they read.",
        "",
        "A module names its components in #components; each is a #Component.",
        "",
        "- one list item names #Widget",
        "- another item",
        "",
        "  an indented line"
      ],
      "example": [],
      "shape": "struct, closed, `kind: \"Module\"`",
      "embeds": [],
      "cue": "#Module: {\n    apiVersion: \"example.com/v1\"\n    kind:       \"Module\"\n\n    metadata: {\n        // The module's name, unique in its registry.\n        name!:    #NameType\n        version!: string\n\n        labels?: #LabelsType\n    }\n\n    // The components, keyed by id.\n    #components: #ComponentMap\n\n    debug: bool | *false // a trailing comment\n\n    if debug {\n        trace!: string\n    }\n}",
      "uses": [
        "#Component",
        "#LabelsType",
        "#NameType"
      ],
      "usedBy": [],
      "rules": [
        {
          "rule": "A field the definition does not declare is refused: the definition is closed.",
          "by": "cue"
        },
        {
          "rule": "A value is incomplete until each required field (`!`) is set, and CUE names the missing one when it needs a complete value: `metadata.name`, `metadata.version`, `trace` when `debug`.",
          "by": "cue"
        },
        {
          "rule": "`_count < 10` must hold (`_ok`).",
          "by": "cue"
        }
      ]
    },
    {
