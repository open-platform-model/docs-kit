    {
      "name": "#NameType",
      "anchor": "nametype",
      "page": "types",
      "file": "src/types.cue",
      "summary": "An RFC 1123 DNS label.",
      "notes": [],
      "example": [
        "\"web\" // valid"
      ],
      "shape": "string constraint",
      "embeds": [],
      "cue": "#NameType: string & =~\"^[a-z0-9]([-a-z0-9]*[a-z0-9])?$\" & strings.MinRunes(1) & strings.MaxRunes(63)",
      "uses": [],
      "usedBy": [
        "#Module"
      ],
      "rules": [
        {
          "rule": "The string must match this regular expression:",
          "code": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "by": "cue"
        },
        {
          "rule": "The string must be 1 to 63 runes long.",
          "by": "cue"
        }
      ]
    },
